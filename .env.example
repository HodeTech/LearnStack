# LearnStack — local dev environment variables (single source of truth).
#
# Copy to `.env` at the repo root (NOT committed — `.gitignore` covers it).
# `infra/compose/dev.yml` and `infra/compose/e2e.yml` read this via the
# `${VAR:-default}` interpolation Compose performs at file-parse time
# (every reference has a dev-safe fallback so the stack still boots even
# without `.env`).
#
# It only reaches Compose through an explicit `--env-file .env`. Compose
# resolves its default env file from the project directory — `infra/compose/` —
# not from the cwd, so a bare `docker compose -f infra/compose/dev.yml …` from
# the repo root ignores this file entirely and every value below falls back.
# `make`, `scripts/seed.sh` and the commands in `infra/*/README.md` pass the
# flag; anything you type by hand has to as well.
#
# The Dapr Vault token chain runs through Dapr's own
# `secretKeyRef` + local-env-secret-store indirection — `.env` → compose
# env → daprd's process env → `secretstore-envvar.yaml` (the
# `secretstores.local.env` component named `envvar-secrets`) →
# `secretstore-vault.yaml` `secretKeyRef`. Dapr does not support a
# `{{env.VAR}}` template; the indirection is the only sanctioned shape.
# See `infra/dapr/README.md` § Vault token for the full walk.
#
# Every value below is a **dev-only** default. Production wires the real
# values through `ISecretProvider` against an authenticated Vault cluster
# per Standards 12 § Secrets Management — `.env.example` is the local
# parity, not the production source.

# ─── Postgres (PostgreSQL 18 per ADR-0031) ───────────────────────────────
# The superuser the container boots as. It owns nothing the application uses:
# every LearnStack table is owned by learnstack_migration below, because an
# owner defeats its own Row Level Security policies and every isolation test
# would then pass against policies that constrain nothing.
POSTGRES_USER=learnstack
POSTGRES_PASSWORD=learnstack
POSTGRES_DB=learnstack

# ─── The database roles (ADR-0003 Amendment 3, 14) ───────────────────────
# Read by infra/compose/postgres-init/02-create-roles.sql through psql's
# \getenv on first boot. Four baseline roles, the confined fifth and sixth
# below, and one login credential each; the role model is closed and a further
# role requires an ADR. Additional application-role sources do not create
# roles (ADR-0076/0077).
# An unset variable aborts initdb rather than creating a passwordless role.
LEARNSTACK_MIGRATION_PW=learnstack-migration-dev
LEARNSTACK_APP_PW=learnstack-app-dev
LEARNSTACK_PLATFORM_PW=learnstack-platform-dev
LEARNSTACK_OUTBOX_PW=learnstack-outbox-dev
# ADR-0097 confined machine intake; no business/Platform/outbox access.
LEARNSTACK_IDENTITY_INGRESS_PW=learnstack-identity-ingress-dev
# ADR-0104 offline issuer-rebind tool only; no API, worker, seeder or web host
# ever receives this credential or its connection string.
LEARNSTACK_IDENTITY_REBIND_PW=learnstack-identity-rebind-dev

# ─── Baseline connection strings ────────────────────────────────────────
# Double underscore is the .NET environment spelling of `ConnectionStrings:X`.
# These are NOT interchangeable and must not be unified in any environment,
# local development included — see Standards 05 § Database roles.
#
#   Migration        — `make migrate` and the deploy job ONLY. Never present in
#                      API or worker runtime configuration: the role owns every
#                      table, and a runtime that is the owner is the arrangement
#                      FORCE ROW LEVEL SECURITY exists to defeat.
#   Default          — ordinary request/job business owners. NOBYPASSRLS.
#   PlatformAdmin    — resolvable only by PlatformAdminScope. BYPASSRLS.
#   OutboxDispatcher — the API's dispatcher stores only: the OutboxProcessor, the DeliveryProcessor and
#                      the operator recovery lane behind them. Never Seeder or web.
ConnectionStrings__Migration='Host=localhost;Port=5432;Database=learnstack;Username=learnstack_migration;Password=learnstack-migration-dev'
ConnectionStrings__Default='Host=localhost;Port=5432;Database=learnstack;Username=learnstack_app;Password=learnstack-app-dev'
ConnectionStrings__PlatformAdmin='Host=localhost;Port=5432;Database=learnstack;Username=learnstack_platform;Password=learnstack-platform-dev'
ConnectionStrings__OutboxDispatcher='Host=localhost;Port=5432;Database=learnstack;Username=learnstack_outbox_admin;Password=learnstack-outbox-dev'
# API/Seeder startup qualifies the coupled backend-only
# IdentityAuthorization / AuthorizationEvidence sources use the SAME app role.
# Development may derive both only for direct PostgreSQL; other modes require
# both explicit strings. Do not add one alone or expose either to the web.
# docs/standards/05-database.md#authorization-and-evidence-source-ledger owns
# source limits, actual cleanup and the independent PgBouncer backend lanes.
# The selected runtime child receives both keys; restore/build and web do not.

# ─── Keycloak (two realms per ADR-0004 Amendment 1) ──────────────────────
# The Development API defaults to the loopback tenant issuer declared in
# backend/src/LearnStack.Api/appsettings.Development.json. Other deployment modes
# require an explicit canonical HTTPS issuer; the API and authority installer use it.
Authentication__Tenant__Issuer=http://localhost:8080/realms/learnstack
# Global identity uses an explicit stable deployment ID, not a hash of the issuer.
# `make migrate` installs/verifies BOTH explicit keys as one immutable registration.
# This fixed ID is local development data; deployment owners choose their stable ID.
Identity__AuthorityId=019a1929-5450-7bbb-8df1-516e8e002501
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-secret
# Server-only BFF client source. Old local .env files must add it explicitly;
# reconciliation verifies an existing confidential secret and never rotates it.
# Never pass this value to the API, public renderer or .NET Seeder.
KEYCLOAK_WEB_CLIENT_SECRET=learnstack-web-dev-secret
# Separate API-only machine client provisioned by realm reconciliation (ADR-0097).
# Keep this secret distinct from web/admin credentials. Warm realms require an
# explicit source RealmId read from Keycloak's realm representation (its immutable id).
IdentityEvents__ClientSecret=learnstack-event-reader-dev-secret
# ADR-0099 confined federation admin client (realm-management/manage-identity-providers
# only). Keycloak imports it as ${KEYCLOAK_FEDERATION_ADMIN_SECRET}; realm reconciliation
# verifies an existing secret and never rotates it. The API reads the same value as
# Federation__ClientSecret; without it federation stays unconfigured and fails closed.
# Keep it distinct from every other credential; never pass it to the web or the Seeder.
KEYCLOAK_FEDERATION_ADMIN_SECRET=learnstack-federation-admin-dev-secret
Federation__ClientSecret=learnstack-federation-admin-dev-secret
# ADR-0107 section 7 confined account-removal client (realm-management/manage-users only;
# it can also create and update users, so treat its secret as the most sensitive machine
# credential). Keycloak imports it as ${KEYCLOAK_ACCOUNT_REMOVAL_SECRET}; realm
# reconciliation verifies an existing secret and never rotates it. The API reads the same
# value as AccountRemoval__ClientSecret; without it account removal stays unconfigured and
# every closure refuses at its last step. Keep it distinct from every other credential
# (the federation admin secret included); never pass it to the web or the Seeder.
KEYCLOAK_ACCOUNT_REMOVAL_SECRET=learnstack-account-removal-dev-secret
AccountRemoval__ClientSecret=learnstack-account-removal-dev-secret
# Optional operator egress allow-list for private or non-443 IdP hosts (exact host or
# host:port, no wildcard). Empty by default; tenant input can never extend it.
# Federation__Egress__AllowedHosts__0=idp.corp.internal:8443
# IdentityEvents__RealmId=<actual retained realm id>
# ConnectionStrings__IdentityIngress=Host=localhost;Port=5432;Database=learnstack;Username=learnstack_identity_ingress;Password=<private fifth-role password>
# The sixth role's connection string exists ONLY in the environment of the offline
# rebind tool for the minutes it runs (docs/runbooks/identity-issuer-rebind.md).
# Never place it in this file, a compose service block or a host configuration:
# ConnectionStrings__IdentityRebind=Host=<host>;Port=5432;Database=learnstack;Username=learnstack_identity_rebind;Password=<sixth-role password>
# Optional native tenant BFF (ADR-0070). Explicit false keeps the anonymous demo
# independent of Keycloak. For local watch mode, opt in with true and the issuer
# below; production launch requires an HTTPS issuer and a trusting private CA.
# All present root/web/process values must agree. Private source files are 0600.
LEARNSTACK_BFF_ENABLED=false
# LEARNSTACK_BFF_ISSUER=http://localhost:8080/realms/learnstack
# Optional callback-only TLS listener in the SAME managed native runtime child.
# Explicit true requires BFF=true and every callback setting below. Configure
# existing native TLS first, then `make backchannel-tls`; no trust/hosts/env edits.
# infra/keycloak/README.md#native-back-channel-logout owns setup and recovery.
LEARNSTACK_BFF_BACKCHANNEL_ENABLED=false
# LEARNSTACK_BFF_BACKCHANNEL_URL=https://host.docker.internal:3443/api/auth/backchannel/keycloak
# LEARNSTACK_BFF_BACKCHANNEL_BIND_ADDRESS=0.0.0.0
# LEARNSTACK_BFF_BACKCHANNEL_TLS_CERT=.data/tls/backchannel/leaf.pem
# LEARNSTACK_BFF_BACKCHANNEL_TLS_KEY=.data/tls/backchannel/leaf-key.pem
# LEARNSTACK_BFF_BACKCHANNEL_CA=.data/tls/backchannel/ca.pem
# PUBLIC root verifying the EXISTING native localhost leaf (never rootCA-key.pem).
# LEARNSTACK_BFF_BACKCHANNEL_NATIVE_CA=<absolute mkcert CAROOT>/rootCA.pem
# Enabled native BFF/API scope admission also requires a SEPARATE 32-random-byte
# canonical base64url secret (43 characters), matching in both server owners.
# It must differ from LEARNSTACK_PUBLIC_HOP_SECRET; never expose it to a browser.
# Identity__NativeSession__CurrentSecret=<private canonical base64url value>
# Identity__NativeSession__HttpsPort=3000
# Global account creation stays disabled unless the API explicitly opts in.
# Identity__SelfBootstrap__Enabled=false
# Custom-field and consent mutations require an independently provisioned,
# deployment-shared HMAC ring. Retain old keys for physical rows and backups;
# see ADR-0095 § Derived replay fingerprints. No key is generated by the launcher.
# Idempotency__CustomFields__CurrentKeyId=local-v1
# Idempotency__CustomFields__Keys__local-v1=<private canonical base64 32-byte key>

# ─── Vault (-dev mode; token shared with Dapr secret-store component) ────
# Boots the `vault` compose service via `-dev-root-token-id` AND is passed
# into the `dapr-sidecar-api` service env so Dapr's `secretstore-vault.yaml`
# component can resolve `vaultToken` through `secretKeyRef` against the
# local-env secret store (`secretstore-envvar.yaml` → `envvar-secrets`).
# Changing this value updates Vault boot + Dapr auth in one shot.
VAULT_ROOT_TOKEN=learnstack-dev-root-token

# ─── LiveKit (dev key/secret; production rotates via ILiveClassProvider) ─
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-32-byte-min-length-padding-xyz

# ─── Coturn (long-term credentials; production uses use-auth-secret) ─────
COTURN_USER=devuser
COTURN_PASSWORD=devsecret

# ─── SeaweedFS S3 (dev identities; production loads from Vault) ──────────
# These values MUST match `infra/seaweedfs/s3-identities.json` because that
# file is what SeaweedFS actually reads at boot (the binary does not support
# env-var substitution in its identity config). The vars here document the
# canonical credential for the future backend `IStorageProvider` adapter
# (Phase 02b+) and any developer S3 CLI scripts; changing them WITHOUT
# updating the JSON above means the backend tries to talk with a key the
# server has never seen. Production swaps both for Vault-issued credentials.
SEAWEEDFS_ACCESS_KEY=learnstack
SEAWEEDFS_SECRET_KEY=learnstack-dev-secret

# ─── Meilisearch (dev master key; production loads from Vault) ───────────
# Read by the `meilisearch` compose service. Every search request carries it
# as a bearer token; Meilisearch refuses to start in `production` env without
# one. Standards 12 § Development credentials requires the `${VAR:-default}`
# indirection rather than a literal in `dev.yml`.
MEILI_MASTER_KEY=learnstack-dev-master-key

# ─── Backend host (LearnStack.Api, runs on workstation via `dotnet run`) ─
# `dotnet run` reads no `.env`, so these two lines are documentation. The API's launch
# profile, backend/src/LearnStack.Api/Properties/launchSettings.json, sets the same two.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# ─── Public renderer (ADR-0053; API and web share this private source) ───
# make public-env fills the empty secret with 32 random bytes encoded as ASCII.
# No TLS/hosts/trust-store changes are automatic. See README Quickstart.
# make public-api loads application/platform-admin/dispatcher DB credentials
# plus network AND secret.
# pnpm dev/start loads these values; an optional web .env.local must match.
LEARNSTACK_PUBLIC_API_ORIGIN=http://127.0.0.1:5080
LEARNSTACK_PUBLIC_HOP_SECRET=
LEARNSTACK_PUBLIC_TLS_CERT=.data/tls/public.pem
LEARNSTACK_PUBLIC_TLS_KEY=.data/tls/public-key.pem
