#!/usr/bin/env bash
# LearnStack commit-msg hook.
#
# Activated via `git config core.hooksPath .githooks` (run by `make install`), and
# run by CI's commit-hygiene step on every commit of a pull request. One script in
# both places is what keeps the two verdicts the same: two copies of the grammar
# drifted before, and so did the rules for which text each copy even looked at.
#
# Enforces the subject rules in `docs/standards/14-git-workflow.md` § Commits. The
# point is where the failure lands: CI catches a bad subject after a push, and a
# subject is a thing you can only fix by rewriting history. Locally it is a retry.
#
# Deliberately NOT checked here: the `ADR:` / `Module:` trailers. Whether a
# commit needs one depends on what it touches and on judgement a hook does not
# have, and a hook that guessed would be one people disable.
#
# Environment:
#   LEARNSTACK_COMMIT_MSG_STRICT=1  CI's mode. Refuses the autosquash markers a local
#                                   fixup workflow needs, and an empty message.
#   GIT_EDITOR=:                    git sets it when no editor ran (`-m`, `-F`); CI sets
#                                   it too, because a stored message is already clean.

set -eu -o pipefail

message_file="$1"
strict="${LEARNSTACK_COMMIT_MSG_STRICT:-0}"

# A merge's subject is generated by git, not authored. Asked of git rather than read
# off the subject, because a hand-written "Merge …" on an ordinary commit is not one.
if [ "$strict" != 1 ] && git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    exit 0
fi

# Judge the subject git will store, not the file's first line. Git's default cleanup
# strips comment lines only when an editor ran — and it runs this hook with GIT_EDITOR=:
# exactly when none did — so after `-m` or `-F` a leading `#` line IS the subject.
# `commit.cleanup` overrides that default either way. A `--cleanup=` given on the command
# line cannot be seen from here: the hook then judges git's default, and CI, which reads
# the message git actually stored, is what catches a subject the flag changed.
cleanup=$(git config --get commit.cleanup 2>/dev/null || true)
case "$cleanup" in
    strip) strip_comments=1 ;;
    whitespace | verbatim) strip_comments=0 ;;
    *) if [ "${GIT_EDITOR-}" = ":" ]; then strip_comments=0; else strip_comments=1; fi ;;
esac

if [ "$strip_comments" = 1 ]; then
    cleaned=$(git stripspace --strip-comments < "$message_file")
else
    cleaned=$(git stripspace < "$message_file")
fi

# The first paragraph, its lines joined by single spaces: what `git log --format=%s`
# prints. awk reads to the end instead of exiting at the first line — under pipefail an
# early-exiting reader SIGPIPEs its writer on a long message, and the `head -1` this
# replaced killed the hook with no output (measured: a 10 MB message exited 141). The
# lines are collected and joined once, not appended one by one: appending re-copies the
# string every line, and a 10 MB first paragraph took 38 seconds that way.
subject=$(printf '%s\n' "$cleaned" | awk '
    done { next }
    NF == 0 { if (n > 0) done = 1; next }
    { line[n++] = $0 }
    END { for (i = 0; i < n; i++) printf "%s%s", (i ? " " : ""), line[i]; print "" }')

if [ -z "$subject" ]; then
    if [ "$strict" = 1 ]; then
        echo "commit-msg: the commit has no subject" >&2
        exit 1
    fi
    # Git aborts an empty message itself, with its own explanation.
    exit 0
fi

# git's autosquash markers (`--fixup`, `--squash`, `--fixup=amend:`). They exist to be
# squashed before review, so they pass locally and are refused on a pull request.
case "$subject" in
    "fixup! "* | "squash! "* | "amend! "*)
        if [ "$strict" != 1 ]; then
            exit 0
        fi
        echo "commit-msg: an autosquash commit reached the pull request — squash it first:" >&2
        echo "  ${subject:0:200}" >&2
        exit 1
        ;;
esac

# What a refusal prints: the subject, cut to something a terminal or a CI annotation
# can show. The checks below still see all of it.
shown="$subject"
if [ "${#shown}" -gt 200 ]; then
    shown="${shown:0:200}…"
fi

fail=0

# Characters, not bytes, whatever the locale. `${#subject}` counts bytes under C or
# POSIX — what a GUI client or a bare image often runs with — and an em dash or a §
# is three bytes. Dropping the UTF-8 continuation bytes leaves one byte per character.
length=$(printf '%s' "$subject" | LC_ALL=C tr -d '\200-\277' | wc -c)
length=$((length))

if [ "$length" -gt 72 ]; then
    echo "commit-msg: subject is $length characters (limit 72):" >&2
    echo "  $shown" >&2
    fail=1
fi

# LC_ALL=C so `[a-z]` means ASCII a to z in every locale. A here-string rather than a
# pipe, so there is no writer for an early-exiting `grep -q` to kill.
if ! LC_ALL=C grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9., /-]+\))?!?: .+' <<<"$subject"; then
    echo "commit-msg: subject is not Conventional Commits:" >&2
    echo "  $shown" >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo >&2
    echo "Standards 14 § Commits: type(scope): subject — imperative, at most 72 characters." >&2
    if [ "$strict" = 1 ]; then
        echo "Reword the commit — \`git commit --amend\` for the last one, \`git rebase -i\` for an earlier one — and push again." >&2
    else
        echo "Nothing was committed. The message is kept; retry with:" >&2
        echo "  git commit -e -F $message_file" >&2
    fi
    exit 1
fi
