<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Packages actively referenced by Phase-01 scaffolding.
  -->
  <ItemGroup Label="Phase-01 (in use)">
    <!-- ASP.NET / hosting (Api host) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />

    <!-- EF Core (per-module Infrastructure projects) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- The raw ADO.NET provider. Referenced by the integration fixture, which
         connects as each of the four database roles directly: the assertions are
         about what a role can and cannot do, and a DbContext in the way would
         test the DbContext. Same major as the EF provider above, which depends
         on it. -->
    <PackageVersion Include="Npgsql" Version="10.0.0" />

    <!-- Application infrastructure (per-module Application projects) -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="11.10.0" />

    <!-- Validation adapter (LearnStack.Infrastructure.Validation only) -->
    <!-- JSON Schema draft 2020-12 evaluation for tenant-authored schemas (ADR-0043).
         PINNED AT 8.0.5 AND IT IS A CEILING, NOT A HOLD: 8.0.5 is the last release
         whose whole resolved graph (JsonPointer.Net 6.0.1, Json.More.Net 2.2.0,
         Humanizer.Core 3.0.1) is a plain MIT expression. From 9.0.0 the NuGet binary
         ships under the Open Source Maintenance Fee EULA — the source stays MIT and
         redistribution is unrestricted, but taking the prebuilt artifact puts a
         monthly fee agreement in the dependency graph. Bumping this is a decision,
         not a chore; there is no later MIT-expression release to move into. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />

    <!-- Strongly-typed ID + value object source generator (ADR-0023).
         Referenced via PrivateAssets="all" in every project that hosts
         [ValueObject<>] declarations (SharedKernel for cross-cutting VOs,
         each Modules.<X>.Domain for aggregate-root IDs). -->
    <PackageVersion Include="Vogen" Version="7.0.0" />

    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

    <!-- Architecture tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- Integration test infrastructure. Phase 02a Packet 6 brought the first
         real Testcontainers-backed suite: the four-role provisioning cases, both
         migration chains and the schema-level isolation suite, all under
         `[Trait("Requires","Docker")]` in CI's `backend-integration` job. -->
    <PackageVersion Include="Testcontainers" Version="3.10.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <!-- Versioned here and referenced by NO project. That is the whole state: a
         PackageVersion binds a version if someone asks; it pulls nothing on its own.
         The integration project used to carry a PackageReference to both and use
         neither, which restores them on every build for nothing.

         Kept versioned rather than deleted because both have a named consumer: `Testcontainers.Redis` is the RESP-compatible
         container the Valkey-backed `ICacheService` adapter will need in Phase 11
         (the .NET library publishes it under that identifier — there is no
         `Testcontainers.Valkey` on NuGet, and the container takes any
         RESP-compatible image via builder config, Valkey 8 per ADR-0030).
         `Respawn` resets a database between tests, which the schema suite does not
         need — its cases roll back or clean up after themselves, because the
         fixture's seeded row counts are what the isolation assertions compare
         against. If Phase 03's second module context does not need it either,
         drop it then. -->
    <PackageVersion Include="Testcontainers.Redis" Version="3.10.0" />
    <PackageVersion Include="Respawn" Version="6.2.1" />
  </ItemGroup>

  <!--
    Phase 02a Packet 3 — Cross-cutting foundation (ADR-0032).
    Serilog primary logger + OTLP sink, OpenTelemetry SDK with the canonical
    instrumentations + TenantContextSpanProcessor + OTLP exporter, Polly v8
    Resilience for IProviderResilience<TPort>, and the Sentry SDK referenced
    only by LearnStack.Infrastructure.ErrorTracking (enforced by the
    Modules_Do_Not_Reference_Sentry_SDK_Directly architecture test).
  -->
  <ItemGroup Label="Phase 02a (in use)">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!--
      IHealthCheck alone, for the `audit` check ADR-0033 Amendment 3 assigns to
      Packet 9. The abstraction rather than the full HealthChecks package: the
      registration and the readiness surface belong to the API host, which has the
      ASP.NET Core shared framework and needs no reference here.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />

    <!-- Serilog (primary logger; OTel via OTLP sink, no AddOpenTelemetry().WithLogging()). -->
    <PackageVersion Include="Serilog" Version="4.1.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.1.1" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- OpenTelemetry SDK + canonical instrumentations + OTLP exporter. -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />

    <!-- Polly v8 + the Microsoft.Extensions.Resilience surface used by
         IProviderResilience<TPort>. -->
    <PackageVersion Include="Polly" Version="8.5.0" />
    <PackageVersion Include="Polly.Extensions" Version="8.5.0" />
    <PackageVersion Include="Polly.RateLimiting" Version="8.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="9.0.0" />

    <!-- Sentry SDK — referenced ONLY by LearnStack.Infrastructure.ErrorTracking
         per ADR-0032 § Sub-decision 9. The architecture test
         Modules_Do_Not_Reference_Sentry_SDK_Directly enforces the scope. -->
    <PackageVersion Include="Sentry" Version="5.0.0" />
  </ItemGroup>

  <!--
    Reserved for later Phase 02a packets (EF migrations + design-time).
  -->
  <!--
    Phase 02a Packet 4 — API conventions (ADR-0024, ADR-0036).
    Scalar renders the OpenAPI document Microsoft.AspNetCore.OpenApi emits.
    Swashbuckle is NOT used: it does not ship a .NET 10 document generator,
    and ADR-0024 § Implementation Notes fixes Microsoft.AspNetCore.OpenApi as
    the generator. Standards 04 § OpenAPI was corrected to match.
  -->
  <ItemGroup Label="Phase 02a Packet 4 (in use)">
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
  </ItemGroup>

  <ItemGroup Label="Reserved for later Phase 02a packets">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>

  <!--
    Roslyn analyzer host packages — referenced by backend/analyzers/.
    Pin to the Microsoft.CodeAnalysis.CSharp version that ships with the .NET 10 SDK.
  -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

</Project>
