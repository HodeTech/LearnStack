<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>LearnStack.Api</RootNamespace>
    <UserSecretsId>learnstack-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
    <ProjectReference Include="..\LearnStack.Application\LearnStack.Application.csproj" />
    <ProjectReference Include="..\LearnStack.Application.Contracts\LearnStack.Application.Contracts.csproj" />
    <ProjectReference Include="..\LearnStack.Infrastructure\LearnStack.Infrastructure.csproj" />
    <ProjectReference Include="..\LearnStack.Infrastructure.Audit\LearnStack.Infrastructure.Audit.csproj" />
    <ProjectReference Include="..\LearnStack.Infrastructure.Observability\LearnStack.Infrastructure.Observability.csproj" />
    <ProjectReference Include="..\LearnStack.Infrastructure.ErrorTracking\LearnStack.Infrastructure.ErrorTracking.csproj" />
    <ProjectReference Include="..\LearnStack.Infrastructure.Resilience\LearnStack.Infrastructure.Resilience.csproj" />

    <ProjectReference Include="..\Modules\Tenancy\LearnStack.Modules.Tenancy.Application\LearnStack.Modules.Tenancy.Application.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\LearnStack.Modules.Tenancy.Infrastructure\LearnStack.Modules.Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Identity\LearnStack.Modules.Identity.Application\LearnStack.Modules.Identity.Application.csproj" />
    <ProjectReference Include="..\Modules\Identity\LearnStack.Modules.Identity.Infrastructure\LearnStack.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Customization\LearnStack.Modules.Customization.Application\LearnStack.Modules.Customization.Application.csproj" />
    <ProjectReference Include="..\Modules\Customization\LearnStack.Modules.Customization.Infrastructure\LearnStack.Modules.Customization.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Audit\LearnStack.Modules.Audit.Application\LearnStack.Modules.Audit.Application.csproj" />
    <ProjectReference Include="..\Modules\Audit\LearnStack.Modules.Audit.Infrastructure\LearnStack.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Content\LearnStack.Modules.Content.Application\LearnStack.Modules.Content.Application.csproj" />
    <ProjectReference Include="..\Modules\Content\LearnStack.Modules.Content.Infrastructure\LearnStack.Modules.Content.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Media\LearnStack.Modules.Media.Application\LearnStack.Modules.Media.Application.csproj" />
    <ProjectReference Include="..\Modules\Media\LearnStack.Modules.Media.Infrastructure\LearnStack.Modules.Media.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Education\LearnStack.Modules.Education.Application\LearnStack.Modules.Education.Application.csproj" />
    <ProjectReference Include="..\Modules\Education\LearnStack.Modules.Education.Infrastructure\LearnStack.Modules.Education.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="MediatR" />

    <!-- Cross-cutting foundation (ADR-0032). Serilog wires through the
         OpenTelemetry OTLP sink; the OTel SDK runs traces + metrics.
         FluentValidation.DependencyInjectionExtensions is kept for the composition
         root's own use; the assembly scan itself lives in LearnStack.Application,
         beside the ValidationBehavior that consumes what it registers. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />

    <!-- Design-time only, and the reason it is HERE rather than only on the
         Infrastructure projects that own the migrations: `dotnet ef` resolves the
         design package from the STARTUP project, and `make migrate` names this one.
         Without it the tool refuses before it opens a connection — "Your startup
         project 'LearnStack.Api' doesn't reference Microsoft.EntityFrameworkCore.Design"
         — which is how Packet 6 shipped a migration no documented path could apply.
         `Migration_Startup_Project_References_EntityFrameworkCore_Design`
         is the guard. PrivateAssets is
         still correct: nothing at runtime touches it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
