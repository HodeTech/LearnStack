<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LearnStack.Tools.Seeder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The module's own Application + Infrastructure, and nothing from LearnStack.Api:
         the seeder is a second composition root, not a client of the first. It shares the
         handlers, the pipeline and the unit of work; it does not share the HTTP surface,
         and a reference to the web project would drag Kestrel, the middleware chain and
         the OpenAPI document into a console tool. -->
    <ProjectReference Include="..\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
    <ProjectReference Include="..\LearnStack.Application\LearnStack.Application.csproj" />
    <ProjectReference Include="..\LearnStack.Infrastructure\LearnStack.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\LearnStack.Modules.Tenancy.Application\LearnStack.Modules.Tenancy.Application.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\LearnStack.Modules.Tenancy.Infrastructure\LearnStack.Modules.Tenancy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the concrete ServiceProvider and console logger, not for IHost: this is a
         one-shot process and builds neither a host nor a configuration stack. The
         referenced projects carry only the *Abstractions* packages, which is why the
         implementations have to come from somewhere, and this is the one meta-package
         Directory.Packages.props already versions that carries both. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
