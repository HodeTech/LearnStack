<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LearnStack.Modules.Tenancy.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
    <!-- The tenant query-filter seam (TenantScopedDbContext) lives in core
         Infrastructure, not in SharedKernel: it calls EF model-building APIs,
         and SharedKernel's EF reference is sanctioned for Vogen-emitted
         converters only (Standards 01 § Build-time-only exceptions). Core
         Infrastructure references no module, so this adds no cycle. -->
    <ProjectReference Include="..\..\..\LearnStack.Infrastructure\LearnStack.Infrastructure.csproj" />
    <ProjectReference Include="..\LearnStack.Modules.Tenancy.Domain\LearnStack.Modules.Tenancy.Domain.csproj" />
    <ProjectReference Include="..\LearnStack.Modules.Tenancy.Application\LearnStack.Modules.Tenancy.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- IDesignTimeDbContextFactory lives here, not in the API: `dotnet ef`
         resolving the API's service provider would take ConnectionStrings:Default,
         the runtime role, which cannot CREATE in schema public. PrivateAssets so
         the design-time surface does not flow to anything referencing this module. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
