<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Audit capture, catalogue and persistence adapters (ADR-0033/0044).
    The MediatR behavior and execution coordinator live in LearnStack.Application;
    these adapters depend on SharedKernel contracts rather than that application
    project. No MediatR dependency is needed here.
  -->

  <PropertyGroup>
    <RootNamespace>LearnStack.Infrastructure.Audit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <!--
      Relational, for one lookup: the capture asks the MODEL whether a property's
      column is jsonb, because deciding that from the value retypes ordinary text
      whose content happens to parse and emits escapes PostgreSQL refuses. The
      annotation is relational metadata, so reading it needs the relational package;
      no provider is referenced and none is needed.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
