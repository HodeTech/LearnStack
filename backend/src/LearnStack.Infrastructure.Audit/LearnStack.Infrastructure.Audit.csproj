<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Audit interceptor + state capture + the MediatR `AuditLogBehavior`
    pipeline (ADR-0033, which supersedes ADR-0016). Phase 02a wires `AuditLogBehavior` into MediatR
    via the core `LearnStack.Application` composition root — that's why we
    pull in `MediatR` here but DO NOT reference `LearnStack.Application`.
    The behavior implements `IPipelineBehavior<,>` (from MediatR) directly;
    Application registers it via DI. Adding a ProjectReference to
    `LearnStack.Application` here would invert the dependency direction.
  -->

  <PropertyGroup>
    <RootNamespace>LearnStack.Infrastructure.Audit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <!--
      Relational, for one lookup: the capture asks the MODEL whether a property's
      column is jsonb, because deciding that from the value retypes ordinary text
      whose content happens to parse and emits escapes PostgreSQL refuses. The
      annotation is relational metadata, so reading it needs the relational package;
      no provider is referenced and none is needed.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
