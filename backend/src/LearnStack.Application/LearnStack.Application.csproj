<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LearnStack.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
    <ProjectReference Include="..\LearnStack.Domain\LearnStack.Domain.csproj" />
    <ProjectReference Include="..\LearnStack.Application.Contracts\LearnStack.Application.Contracts.csproj" />

    <!-- ADR-0032 § Sub-decision 4: LearnStackException-DomainExceptionThrow
         analyzer flags `throw new DomainException(...)` in Application code
         too (handlers should return Result.Fail, not throw). -->
    <ProjectReference Include="..\..\analyzers\LearnStack.Analyzers\LearnStack.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <!-- AddValidatorsFromAssemblies. The package was referenced by LearnStack.Api since
         the pipeline was written; what was never CALLED was AddValidatorsFrom*, which is
         why every validator in the solution was inert: ValidationBehavior resolves
         IValidator<TRequest> from the container and nothing put one there. The call
         belongs here, beside the pipeline that needs it. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Pipeline behaviors require logging + DI abstractions; the concrete
         implementations are wired by the composition root in LearnStack.Api. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
