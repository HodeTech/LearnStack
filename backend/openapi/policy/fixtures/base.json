{
  "openapi": "3.1.0",
  "info": {
    "title": "ADR-0024 policy controls",
    "version": "1"
  },
  "paths": {
    "/api/v1/widgets": {
      "get": {
        "operationId": "GetWidget",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ]
                    },
                    "openKind": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ],
                      "x-extensible-enum": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CreateWidget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    }
  }
}
