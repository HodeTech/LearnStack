{
  "openapi": "3.1.0",
  "info": {
    "title": "ADR-0024 policy controls",
    "version": "1"
  },
  "paths": {
    "/api/v1/widgets": {
      "get": {
        "operationId": "GetWidget",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ]
                    },
                    "openKind": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ],
                      "x-extensible-enum": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CreateWidget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/enum-controls": {
      "get": {
        "operationId": "GetEnumControls",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "a",
                    "b"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "a",
                      "b"
                    ]
                  }
                }
              }
            }
          },
          "202": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Choice"
                }
              }
            }
          },
          "203": {
            "$ref": "#/components/responses/OpenChoice"
          },
          "204": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostEnumControls",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "string",
                    "enum": [
                      "a",
                      "b"
                    ]
                  },
                  "openChoice": {
                    "type": "string",
                    "enum": [
                      "a",
                      "b"
                    ],
                    "x-extensible-enum": true
                  },
                  "quantity": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Choice": {
        "type": "string",
        "enum": [
          "a",
          "b"
        ]
      }
    },
    "responses": {
      "OpenChoice": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "string",
              "enum": [
                "a",
                "b"
              ],
              "x-extensible-enum": true
            }
          }
        }
      }
    }
  }
}
