<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LearnStack.Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LearnStack.SharedKernel\LearnStack.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Domain\LearnStack.Domain.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Application\LearnStack.Application.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Api\LearnStack.Api.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Infrastructure.Observability\LearnStack.Infrastructure.Observability.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Infrastructure.ErrorTracking\LearnStack.Infrastructure.ErrorTracking.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Infrastructure.Resilience\LearnStack.Infrastructure.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
    <!-- Vogen reference so the test project can declare a synthetic
         [ValueObject<Guid>] ID and assert the emitter pipeline end-to-end
         (per ADR-0023 the generator only runs in projects that reference it).
         Microsoft.EntityFrameworkCore is the build-time hook Vogen's emitted
         EF converter requires; the test project does not use EF Core types
         directly. -->
    <PackageReference Include="Vogen" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

</Project>
