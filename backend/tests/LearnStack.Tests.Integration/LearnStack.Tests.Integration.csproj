<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LearnStack.Tests.Integration</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.Mvc.Testing's WebApplicationFactory needs the
         ASP.NET Core shared framework on the test host; the transitive pull-in
         via the host project is brittle on fresh checkouts. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LearnStack.Api\LearnStack.Api.csproj" />
    <!-- The two seed tenants are a Packet 7 deliverable, and what the seeder writes has
         to be asserted against the real schema rather than taken on trust. -->
    <ProjectReference Include="..\..\src\LearnStack.Tools.Seeder\LearnStack.Tools.Seeder.csproj" />
    <!-- The tenancy schema tests apply the module's own migration and assert its
         policies, so they need the migration assembly and the persistence model
         directly — not the DI registration. AddLearnStackPersistence does register
         TenancyDbContext through AddModuleDbContext, but a registration builds a
         context on the ambient connection at request time; it does not give a test
         the Migrations folder to apply. -->
    <ProjectReference Include="..\..\src\Modules\Tenancy\LearnStack.Modules.Tenancy.Infrastructure\LearnStack.Modules.Tenancy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The fixture opens connections as each of the four roles directly, not
         through a DbContext: the point is to prove what a role can and cannot
         do, and an ORM in the way would test the ORM. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="coverlet.collector" />
    <!-- HTTP-level integration tests (CrossCuttingFoundationHttpTests)
         declare a synthetic test controller + MediatR command + FluentValidation
         validator that exercise the L1 handler and ValidationBehavior
         against the real LearnStack.Api host. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
