<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LearnStack.Tests.Integration</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.Mvc.Testing's WebApplicationFactory needs the
         ASP.NET Core shared framework on the test host; the transitive pull-in
         via the host project is brittle on fresh checkouts. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LearnStack.Api\LearnStack.Api.csproj" />
    <!-- The two seed tenants are a Packet 7 deliverable, and what the seeder writes has
         to be asserted against the real schema rather than taken on trust. -->
    <ProjectReference Include="..\..\src\LearnStack.Tools.Seeder\LearnStack.Tools.Seeder.csproj" />
    <ProjectReference Include="..\..\src\LearnStack.Tools.IdentityAuthorityInstaller\LearnStack.Tools.IdentityAuthorityInstaller.csproj" />
    <ProjectReference Include="../LearnStack.Tests.JobLifecycleProbe/LearnStack.Tests.JobLifecycleProbe.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../LearnStack.Tests.AuthorizationEvidenceProbe/LearnStack.Tests.AuthorizationEvidenceProbe.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- The tenancy schema tests apply the module's own migration and assert its
         policies, so they need the migration assembly and the persistence model
         directly — not the DI registration. AddLearnStackPersistence does register
         TenancyDbContext through AddModuleDbContext, but a registration builds a
         context on the ambient connection at request time; it does not give a test
         the Migrations folder to apply. -->
    <ProjectReference Include="..\..\src\Modules\Tenancy\LearnStack.Modules.Tenancy.Infrastructure\LearnStack.Modules.Tenancy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../AuthorizationEvidenceProof/AuthorizationBarrierHarness.cs" Link="Database/AuthorizationBarrierHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The fixture opens connections as each of the four roles directly, not
         through a DbContext: the point is to prove what a role can and cannot
         do, and an ORM in the way would test the ORM. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="coverlet.collector" />
    <!-- HTTP-level integration tests (CrossCuttingFoundationHttpTests)
         declare a synthetic test controller + MediatR command + FluentValidation
         validator that exercise the L1 handler and ValidationBehavior
         against the real LearnStack.Api host. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <!-- Separate test-only module assemblies exercise real job ownership checks. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- The separately launched Linux child owns fatal proof. Never load its
       entry point into the test host or use parent-process termination. -->
  <Target Name="StageJobLifecycleProbe" AfterTargets="Build">
    <ItemGroup>
      <_JobLifecycleProbeFiles Include="$(MSBuildThisFileDirectory)../LearnStack.Tests.JobLifecycleProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Error Condition="'@(_JobLifecycleProbeFiles)' == ''" Text="The job lifecycle proof sidecar was not built." />
    <Copy SourceFiles="@(_JobLifecycleProbeFiles)"
          DestinationFiles="@(_JobLifecycleProbeFiles->'$(OutDir)job-lifecycle-probe/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageAuthorizationEvidenceProbe" AfterTargets="Build">
    <ItemGroup>
      <_AuthorizationEvidenceProbeFiles Include="$(MSBuildThisFileDirectory)../LearnStack.Tests.AuthorizationEvidenceProbe/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Error Condition="'@(_AuthorizationEvidenceProbeFiles)' == ''" Text="The authorization evidence proof sidecar was not built." />
    <Copy SourceFiles="@(_AuthorizationEvidenceProbeFiles)"
          DestinationFiles="@(_AuthorizationEvidenceProbeFiles->'$(OutDir)authorization-evidence-probe/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
