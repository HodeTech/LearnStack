{
  "realm": "learnstack",
  "displayName": "LearnStack — Tenant Users",
  "displayNameHtml": "<strong>LearnStack</strong> — Tenant Users",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "tr"
  ],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "tenant-admin",
        "description": "Tenant administrator — manages users, content, billing within a tenant.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "tenant-instructor",
        "description": "Instructor — authors content + runs live sessions within a tenant.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "tenant-learner",
        "description": "Learner — enrols in courses + attends sessions within a tenant.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-learnstack",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "composites": {
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ],
    "client": {
      "account": [
        {
          "name": "view-profile",
          "description": "${role_view-profile}",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "manage-account",
          "description": "${role_manage-account}",
          "composite": true,
          "clientRole": true,
          "composites": {
            "client": {
              "account": [
                "manage-account-links"
              ]
            }
          }
        },
        {
          "name": "manage-account-links",
          "description": "${role_manage-account-links}",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "view-applications",
          "description": "${role_view-applications}",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "view-consent",
          "description": "${role_view-consent}",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "manage-consent",
          "description": "${role_manage-consent}",
          "composite": true,
          "clientRole": true,
          "composites": {
            "client": {
              "account": [
                "view-consent"
              ]
            }
          }
        },
        {
          "name": "delete-account",
          "description": "${role_delete-account}",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "view-groups",
          "description": "${role_view-groups}",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "learnstack-api",
      "name": "LearnStack API (confidential service)",
      "description": "API resource and legacy dev service account; no browser flow. See infra/keycloak/README.md.",
      "enabled": true,
      "publicClient": false,
      "secret": "learnstack-api-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic",
        "learnstack-tenant-api"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt",
        "organization"
      ]
    },
    {
      "clientId": "learnstack-web",
      "name": "LearnStack Web (confidential BFF, PKCE)",
      "description": "Server-only code/S256 client. Private secret source; no browser secret. See infra/keycloak/README.md.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://demo-english.learnstack.local:3000/api/auth/callback/keycloak",
        "https://demo-yoga.learnstack.local:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://demo-english.learnstack.local:3000/##https://demo-yoga.learnstack.local:3000/"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic",
        "learnstack-tenant-api"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt",
        "organization"
      ],
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_WEB_CLIENT_SECRET}"
    },
    {
      "clientId": "account",
      "name": "${client_account}",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/learnstack/account/",
      "redirectUris": [
        "/realms/learnstack/account/*"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "nodeReRegistrationTimeout": 0,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": []
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/learnstack/account/",
      "redirectUris": [
        "/realms/learnstack/account/*"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },
      "nodeReRegistrationTimeout": 0,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {}
        },
        {
          "name": "learnstack-account-self-service-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "account",
            "usermodel.clientRoleMapping.rolePrefix": "",
            "claim.name": "resource_access.account.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
