# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
# Shared workspace recommendations + cross-language editor settings are
# committed; per-user state (launch.json, history, etc.) stays gitignored.
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# .NET
bin/
obj/
TestResults/
*.user
*.suo
*.rsuser

# Node
node_modules/
.next/
dist/
build/
coverage/

# Environment — track only the explicitly-listed *.example templates,
# never real envs. `!*.example` would un-ignore every future `foo.example`
# file in the tree (e.g. `infra/foo.conf.example`); the explicit allowlist
# below keeps each new template an opt-in decision.
.env
.env.*
!.env.example
!frontend/apps/web/.env.local.example

# Logs
*.log
logs/

# Local infrastructure data
.data/
seaweedfs-data/
postgres-data/
valkey-data/

# Local-only analyses (not shared via git)
docs/analysis/

