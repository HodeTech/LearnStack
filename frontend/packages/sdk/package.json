{
  "name": "@learnstack/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ${LEARNSTACK_OPENAPI:-../../../backend/openapi/v1.json} -o src/generated/schema.d.ts",
    "test": "vitest run",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --max-warnings 0"
  },
  "devDependencies": {
    "@learnstack/config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "eslint": "9.39.4"
  }
}
