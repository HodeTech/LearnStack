{
  "name": "@learnstack/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ${LEARNSTACK_OPENAPI:-http://localhost:5080/openapi/v1.json} -o src/generated/schema.d.ts"
  },
  "devDependencies": {
    "@learnstack/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.6.3"
  }
}
