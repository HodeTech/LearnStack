{
  "name": "@learnstack/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./authenticated-server": "./dist/authenticated-server.js",
    "./administration-server": "./dist/administration-server.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ${LEARNSTACK_OPENAPI:-../../../backend/openapi/v1.json} -o src/generated/schema.d.ts",
    "test": "vitest run",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --max-warnings 0",
    "build:native": "node ../../apps/web/scripts/framework-build.mjs --app-root ../../apps/web --native-only"
  },
  "devDependencies": {
    "@learnstack/config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vitest": "4.1.12",
    "eslint": "9.39.4"
  }
}
