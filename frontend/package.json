{
  "name": "learnstack-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "LearnStack tenant-facing frontend monorepo (single Next.js app per ADR-0009).",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "pnpm --filter @learnstack/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "node ../scripts/run-frontend-tests.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "prettier": "3.3.3"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.27>postcss": "8.5.23"
    }
  }
}
