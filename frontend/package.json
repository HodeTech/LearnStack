{
  "name": "learnstack-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "LearnStack tenant-facing frontend monorepo (single Next.js app per ADR-0009).",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "22.23.1",
    "pnpm": "9.12.3"
  },
  "scripts": {
    "dev": "pnpm --filter @learnstack/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "node ../scripts/run-frontend-tests.mjs",
    "preinstall": "node scripts/install-frontend.mjs --lifecycle",
    "postinstall": "node scripts/install-frontend.mjs --installed",
    "framework:manager": "node scripts/install-frontend.mjs --manager-path"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "lighthouse": "13.5.0",
    "playwright": "1.64.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.28>postcss": "8.5.23",
      "vitest@4.1.12>vite": "6.4.4",
      "vite@6.4.4>esbuild": "0.25.12",
      "chromium-bidi@157.0.8090-0>zod": "4.6.6",
      "ajv@8.20.0>fast-uri": "3.1.9"
    },
    "patchedDependencies": {
      "next@15.5.28": "patches/next@15.5.28.patch"
    }
  }
}
