# Optional narrow projection of repo-root .env; it is NOT required for launch.
# The native launcher reads the root source before Next. If you copy this file,
# every value must exactly match the root source, including its generated secret.
# An empty placeholder here conflicts with a generated root secret: fill it or
# remove the projection. Duplicate/malformed/conflicting values refuse startup.
# No shell evaluation or variable interpolation. No NEXT_PUBLIC_ credentials.
LEARNSTACK_PUBLIC_API_ORIGIN=http://127.0.0.1:5080
LEARNSTACK_PUBLIC_HOP_SECRET=
LEARNSTACK_PUBLIC_TLS_CERT=.data/tls/public.pem
LEARNSTACK_PUBLIC_TLS_KEY=.data/tls/public-key.pem

# OIDC/session and LiveKit client configuration remain Phase 02b / Phase 08c.
