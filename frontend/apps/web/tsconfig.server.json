{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/server",
    "outDir": ".server",
    "noEmit": false,
    "noEmitOnError": true,
    "incremental": false,
    "plugins": []
  },
  "include": [
    "src/server/ingress.ts",
    "src/server/public-admission-runtime.ts",
    "src/server/auth/session-runtime.ts",
    "src/server/auth/provider-core.ts",
    "src/server/auth/backchannel-verifier.ts",
    "src/server/auth/backchannel-configuration.ts",
    "src/server/auth/backchannel-http.ts",
    "src/server/auth/backchannel-bridge.ts",
    "src/server/auth/account-client.ts",
    "src/server/auth/native-session-client.ts",
    "src/server/auth/native-administration-client.ts",
    "src/server/auth/request-runtime.ts",
    "src/server/auth/http-protocol.ts",
    "src/server/auth/configuration.ts",
    "src/server/auth/logout-response.ts",
    "src/server/auth/native-invitation-http.ts",
    "src/server/auth/native-consent-http.ts",
    "src/server/auth/native-invitation-client.ts",
    "src/server/auth/invitation-html.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
