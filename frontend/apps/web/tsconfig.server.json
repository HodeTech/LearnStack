{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/server",
    "outDir": ".server",
    "noEmit": false,
    "incremental": false,
    "plugins": []
  },
  "include": [
    "src/server/ingress.ts",
    "src/server/public-admission-runtime.ts",
    "src/server/auth/session-runtime.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
